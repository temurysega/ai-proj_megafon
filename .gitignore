# Секреты — никогда не коммитить
.env
.env.*
!.env.example
*.key
*.pem

# Локальный режим разработки правил агента (см. docs/architecture.md, хук pre_write)
.dev-mode

# Кэш и временные файлы
.cache/
__pycache__/
*.pyc
*.tmp
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Локальные настройки IDE
.claude/settings.local.json
.vscode/
.idea/

# Тяжёлые сырые медиа (храним только расшифровки и описания)
projects/*/sources/raw/**/*.mp4
projects/*/sources/raw/**/*.mov
projects/*/sources/raw/**/*.wav
projects/*/sources/raw/**/*.mp3
# демонстрационные медиа с синтетическим голосом (без ПДн) — нужны, чтобы проверить ingest на чистом клоне
!projects/antifraud-family/sources/raw/demo-interview.mp3
!projects/antifraud-family/sources/raw/demo-video.mp4

# Песочница smoke-тестов
projects/zz-smoke*/
projects/.active

# Видео демо — большой файл, хранится на сайте (mgim.neblanki.tech/files/demo.mp4), не в git
docs/video/*.mp4
